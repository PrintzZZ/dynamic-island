{
  "name": "dynamic-island",
  "version": "1.0.0",
  "description": "Windows 平台灵动岛 —— Electron + Vue，支持岛内应用扩展",
  "main": "dist-electron/main.js",
  "author": "UsePro",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.usepro.dynamicisland",
    "productName": "DynamicIsland",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DynamicIsland",
      "artifactName": "DynamicIsland-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "DynamicIsland-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.8"
  }
}
